+fn wheel_ticks(remainder: &mut f64, distance: f64) -> i32 {
+    let ticks = (distance / 15.0).trunc() as i32;
+    *remainder += distance - f64::from(ticks) * 15.0;
+    let carry = (*remainder / 15.0).trunc() as i32;
+    *remainder -= f64::from(carry) * 15.0;
+    ticks + carry
+}
+
+#[test]
+fn wheel_ticks_preserve_distance_and_direction() {
+    let mut remainder = 0.0;
+    assert_eq!(wheel_ticks(&mut remainder, -45.0), -3);
+    assert_eq!(wheel_ticks(&mut remainder, 15.0), 1);
+    assert_eq!(wheel_ticks(&mut remainder, 0.0), 0);
+    for _ in 0..4 {
+        assert_eq!(wheel_ticks(&mut remainder, 3.0), 0);
+    }
+    assert_eq!(wheel_ticks(&mut remainder, 3.0), 1);
+    assert_eq!(remainder, 0.0);
+    assert_eq!(wheel_ticks(&mut remainder, -7.5), 0);
+    assert_eq!(wheel_ticks(&mut remainder, -7.5), -1);
+    assert_eq!(wheel_ticks(&mut remainder, 6.0), 0);
+    assert_eq!(wheel_ticks(&mut remainder, -6.0), 0);
+    assert_eq!(remainder, 0.0);
+    assert_eq!(wheel_ticks(&mut remainder, -7.5), 0);
+    assert_eq!(wheel_ticks(&mut remainder, 15.0), 1);
+    assert_eq!(remainder, -7.5);
+    assert_eq!(wheel_ticks(&mut remainder, -7.5), -1);
+    let mut horizontal = 0.0;
+    assert_eq!(wheel_ticks(&mut horizontal, 7.5), 0);
+    assert_eq!(wheel_ticks(&mut remainder, -15.0), -1);
+    assert_eq!(horizontal, 7.5);
+}
