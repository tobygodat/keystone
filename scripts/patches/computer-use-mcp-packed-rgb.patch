+/// Bytes per pixel of the SHM formats a capture accepts: the 32-bit ones, and the
+/// packed 24-bit ones wlroots' headless GLES2 output offers.
+fn bytes_per_pixel(format: wl_shm::Format) -> Option<u32> {
+    match format {
+        wl_shm::Format::Argb8888
+        | wl_shm::Format::Xrgb8888
+        | wl_shm::Format::Abgr8888
+        | wl_shm::Format::Xbgr8888 => Some(4),
+        wl_shm::Format::Bgr888 | wl_shm::Format::Rgb888 => Some(3),
+        _ => None,
+    }
+}
 fn rgb_row(source: &[u8], destination: &mut [u8], format: wl_shm::Format) {
+    // DRM formats name channels from the high bit of a little-endian word, so
+    // BGR888 stores R, G, B in memory order and RGB888 stores B, G, R.
+    match format {
+        wl_shm::Format::Bgr888 => return destination.copy_from_slice(source),
+        wl_shm::Format::Rgb888 => {
+            for (pixel, rgb) in source
+                .as_chunks::<3>()
+                .0
+                .iter()
+                .zip(destination.as_chunks_mut::<3>().0.iter_mut())
+            {
+                rgb.copy_from_slice(&[pixel[2], pixel[1], pixel[0]]);
+            }
+            return;
+        }
+        _ => {}
+    }
